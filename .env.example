# Required — your Anthropic API key
ANTHROPIC_API_KEY=

# Optional but recommended — a GitHub fine-grained or classic PAT with
# read:user scope. Used by the github_search_users custom tool.
# Without it, the tool falls back to unauthenticated requests (60/hour).
GITHUB_PAT=

# Populated by setup_agent.py — leave blank on first setup
ENVIRONMENT_ID=
SKILL_ID=
AGENT_ID=
