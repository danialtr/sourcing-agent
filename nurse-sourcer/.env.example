# Brave Search API — sign up at https://api.search.brave.com/
# Free tier: 2,000 queries/month, 1 query/sec rate limit
BRAVE_API_KEY=BSAxxxxxxxxxxxxx

# Reddit API — register a "script" app at https://www.reddit.com/prefs/apps
# Free, no rate limit issues for our volume
REDDIT_CLIENT_ID=xxxxx
REDDIT_CLIENT_SECRET=xxxxx
REDDIT_USER_AGENT="nurse-sourcer/0.1 by u/your_username"

# YouTube Data API v3 — create a project in Google Cloud Console, enable YouTube Data API
# Free tier: 10,000 quota units/day
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxx

# Optional: Google Custom Search Engine (only used by sources/google_cse.py)
# https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
